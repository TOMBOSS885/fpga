# Copy to .env, edit, then: set -a; source .env; set +a
# .env and *.key are excluded from git and Docker build contexts.
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=REPLACE_WITH_EXACT_SERVED_MODEL_ID
MODEL_NAME=REPLACE_WITH_EXACT_SERVED_MODEL_ID
LLM_CONTEXT_TOKENS=16384
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_S=85
LLM_STREAM=0
# Use an externally mounted file for a remote API key if required:
# LLM_API_KEY_FILE=/run/secrets/model_api_key
# Or set LLM_API_KEY through the process environment.
# LLM_CA_BUNDLE=/path/to/private-ca.pem
FPGACHINA_TOKEN=REPLACE_WITH_SUBMISSION_TOKEN
AGENT_DEADLINE_S=360
AGENT_MAX_REPAIRS=3
AGENT_TB_REPAIRS=1
AGENT_RESERVE_S=8
RTL_PART=xczu3eg-sbva484-1-e
RTL_PERIOD_NS=5
# Official base image already sets toolchain PATH and EDA_TMP.
# For a developer tool installation, use VIVADO_BIN=/actual/Vivado/bin.
# Local AMD measurement: GPU_DRM_CARD=card0 (only if selection is needed).
# Remote model host: VRAM_METRICS_FILE=/run/model-metrics/vram.json
